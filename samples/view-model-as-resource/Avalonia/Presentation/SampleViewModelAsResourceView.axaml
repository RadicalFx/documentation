<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ViewModelAsResourceSample.Presentation"
        x:Class="ViewModelAsResourceSample.Presentation.SampleViewModelAsResourceView"
        Title="ViewModel as resource" Height="200" Width="400">
    <Grid Margin="12">
        <TextBlock Text="{Binding Foo, DataType=local:SampleViewModelAsResourceViewModel}" DataContext="{DynamicResource SampleViewModelAsResourceViewModel}" />
    </Grid>
</Window>
