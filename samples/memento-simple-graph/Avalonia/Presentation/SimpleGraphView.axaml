<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MementoSimpleGraphSample.Presentation"
        x:Class="MementoSimpleGraphSample.Presentation.SimpleGraphView"
        x:DataType="local:SimpleGraphViewModel"
        Title="Memento: simple graph" Height="250" Width="400">
    <StackPanel Margin="12" Spacing="8">
        <TextBox Text="{Binding Entity.LastName}" />
        <TextBox Text="{Binding Entity.FirstName}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Undo" Command="{Binding UndoCommand}" />
            <Button Content="Redo" Command="{Binding RedoCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
